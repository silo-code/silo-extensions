{
  "name": "@silo-extensions/follow-ups",
  "displayName": "Follow-ups",
  "version": "0.2.3",
  "description": "Mark any tab — editor, terminal, or dock panel — to come back to later, with a color-coded label and an optional note. Tab tint, toolbar dropdown, workspace rollup, a cross-workspace Navigator view, and a settings page to name your labels.",
  "type": "module",
  "files": [
    "dist/",
    "build.mjs"
  ],
  "silo": {
    "id": "silo.follow-ups",
    "engine": "^0.65.0",
    "main": "dist/index.js",
    "publisher": "Silo",
    "permissions": []
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node --watch build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@silo-code/sdk": "^0.60.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
